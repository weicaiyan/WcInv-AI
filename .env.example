# WcInv local runtime configuration
# Copy to .env or set these variables in your shell before starting services.

DB_URL=jdbc:mysql://localhost:3306/wcinv?useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_unicode_ci&serverTimezone=Asia/Shanghai
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wcinv
DB_USER=wcinv
DB_PASSWORD=change_me

# Use a long random value in real environments.
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRATION_MS=604800000

# Required for data fetch scripts. Do not commit the real token.
LIXINGER_TOKEN=change_me
