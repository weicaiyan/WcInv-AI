{
  "endpoint": "GET /api/v1/indices/{indexCode}/temperature-history",
  "params": {
    "indexCode": "string, path variable, e.g. 000300",
    "days": "int, query, default 3650"
  },
  "response": {
    "data": {
      "index_code": "string",
      "index_name": "string",
      "history": [
        {
          "date": "string (yyyy-MM-dd)",
          "pe_temp": "number (0-100, 2 decimal places, BigDecimal HALF_UP)",
          "pb_temp": "number (0-100, 2 decimal places, BigDecimal HALF_UP)",
          "temperature": "number (0-100, 2 decimal places, = (pe_temp+pb_temp)/2, HALF_UP)"
        }
      ]
    }
  },
  "sampling": "monthly, last trading day of each month",
  "source_table": "index_valuation (index_code, index_name, trade_date, pe_percentile, pb_percentile)",
  "temperature_formula": "(pe_percentile + pb_percentile) / 2, rounded HALF_UP to 2 decimal places",
  "sort": "trade_date ASC",
  "available_indices": [
    {"code": "000300", "name": "沪深300"},
    {"code": "000016", "name": "上证50"},
    {"code": "000905", "name": "中证500"},
    {"code": "000852", "name": "中证1000"},
    {"code": "399006", "name": "创业板指"},
    {"code": "399005", "name": "中小板指"},
    {"code": "000688", "name": "科创50"},
    {"code": "000015", "name": "红利指数"},
    {"code": "000922", "name": "中证红利"},
    {"code": "399324", "name": "深证红利"},
    {"code": "000925", "name": "基本面50"},
    {"code": "930782", "name": "500SNLV"}
  ]
}
